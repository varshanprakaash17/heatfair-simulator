# Local development only. Copy to .env.local (next dev) or .dev.vars (wrangler dev).
#
# The browser calls the same-origin /api/v1 proxy route; this URL is read on the
# server and forwarded there. It is never baked into the client bundle, so
# changing it needs no rebuild in production.
HEATFAIR_API_URL=http://127.0.0.1:8000

# Only set this to make the browser call a different API origin directly
# (bypassing the proxy). Leave it unset for normal deployments.
# NEXT_PUBLIC_API_URL=
