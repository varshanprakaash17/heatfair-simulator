# HeatFair — environment configuration
# Copy to .env (backend) and frontend/.env.local. Never commit real credentials.

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# Local development default is SQLite; no database server required.
# Managed Postgres / Supabase:
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./heatfair.db

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTO_SEED_DEMO=true
REPORTS_DIR=./reports
WEATHER_CACHE_SECONDS=900

# Optional: Supabase service-role key. Server-side only. NEVER expose to the browser.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
