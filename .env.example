# HeatFair — environment configuration
# Copy to .env (backend) and frontend/.env.local. Never commit real credentials.

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# Local development default is SQLite; no database server required.
# Managed Postgres / Supabase:
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./heatfair.db

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTO_SEED_DEMO=true
REPORTS_DIR=./reports
WEATHER_CACHE_SECONDS=900

# ---------------------------------------------------------------------------
# Google sign-in (required for sign-in outside local development)
# ---------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# and add the authorised redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit redirect URI; derived from the request when blank.
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Origin the API returns the browser to after sign-in (default shown).
FRONTEND_URL=http://localhost:3000
# Password sign-in is a local-development escape hatch; leave false in production.
PASSWORD_LOGIN_ENABLED=false

# Optional: Supabase service-role key. Server-side only. NEVER expose to the browser.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
